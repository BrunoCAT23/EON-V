ROBOT_NAME=EON-V
RUNTIME_MODE=simulation

# Voice modes: stub / mic_ready, stub / real_ready, fallback / local_ready / cloud_ready
MIC_MODE=stub
SPEAKER_MODE=stub
STT_MODE=fallback
TTS_MODE=fallback

# Vision modes: stub / opencv_ready, stub / yolo_ready
CAMERA_MODE=stub
DETECTOR_MODE=stub
OPENCV_CAMERA_INDEX=0
YOLO_MODEL_PATH=models/yolo_placeholder.onnx

# Hardware modes: mock / pi_ready / arduino_bridge
HARDWARE_MODE=mock
ARDUINO_PORT=COM5
ARDUINO_BAUDRATE=115200
ARDUINO_TIMEOUT=1.0

# LLM
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

RUNTIME_TICK_DELAY=1.0

# Memory
MEMORY_FILE=memory/data.json
MEMORY_SANDBOX=false

# Voice profile. Use "cinematic_ai" for a calm, polished assistant style.
VOICE_PROFILE=eon_default
VOICE_STYLE=warm_ukrainian_companion
VOICE_RATE=1.0
VOICE_PITCH=1.0
WAKE_WORDS=eon,eon-v,еон,еон-ві,йон,іон,єон,e on
WAKE_WORD_FUZZY=true
WAKE_WORD_MAX_DISTANCE=1
WAKE_ACK_SOUND=wake_ack
WAKE_FOLLOWUP_CAPTURE=true
WAKE_REPLY_TEXT=Так?
DO_NOT_DISTURB=false
MIC_SAMPLE_RATE=16000
MIC_RECORD_SECONDS=4.0
MIC_CAPTURE_MODE=vad
VAD_FRAME_MS=30
VAD_MAX_RECORD_SECONDS=6.0
VAD_MIN_SPEECH_SECONDS=0.25
VAD_SILENCE_MS=700
VAD_PREROLL_MS=300
VAD_CALIBRATION_MS=300
VAD_ENERGY_THRESHOLD=350
VAD_NOISE_MULTIPLIER=2.5
VOSK_MODEL_PATH=models/vosk
PIPER_EXE_PATH=tools/piper/piper.exe
PIPER_VOICE_PATH=tools/piper/voices/uk_UA-ukrainian_tts-medium.onnx

# Hardware safety
MAX_MOTOR_SPEED=60
MIN_SERVO_ANGLE=25
MAX_SERVO_ANGLE=155
MOTION_ENABLED=true
MOTION_DRY_RUN=true
MOTION_COMMAND_TIMEOUT=3.0

# Startup sound
STARTUP_SOUND_ENABLED=true
STARTUP_SOUND_PATH=sounds/eon_startup.wav
STARTUP_SOUND_VOLUME=0.7
SOUND_EFFECTS_ENABLED=true
SOUND_EFFECTS_VOLUME=0.8
SOUND_EFFECTS_DIR=sounds

# Live runtime and diagnostics
LIVE_VOICE_INTERVAL=4.0
LIVE_VISION_INTERVAL=2.0
LIVE_RUNTIME_INTERVAL=1.0
LIVE_MAX_CYCLES=0
LAST_FRAME_PATH=logs/last_frame.jpg
VOICE_TEST_PHRASE=Привіт. Я EON-V. Голосова система працює.
